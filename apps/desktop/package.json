{
  "name": "@architect/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node esbuild.mjs",
    "start": "pnpm build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package:dir": "pnpm build && electron-builder --dir",
    "package": "pnpm build && electron-builder"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@architect/agent": "workspace:*",
    "@architect/core": "workspace:*",
    "@architect/i18n": "workspace:*",
    "@architect/interop": "workspace:*",
    "@architect/mcai": "workspace:*",
    "@architect/render": "workspace:*",
    "@architect/tools": "workspace:*",
    "antd": "5.29.3",
    "dompurify": "3.4.15",
    "fflate": "^0.8.2",
    "marked": "18.0.12",
    "minecraft-assets": "^1.19.0",
    "minecraft-data": "^3.116.0",
    "prismarine-block": "^1.22.0",
    "prismarine-chunk": "^1.41.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/dompurify": "3.0.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "^0.180.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "27.0.0",
    "three": "^0.180.0"
  },
  "description": "ArchItect —— 用多模态 LLM 设计 Minecraft 建筑",
  "author": "ArchItect",
  "build": {
    "appId": "dev.architect.app",
    "productName": "ArchItect",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/minecraft-assets/minecraft-assets/data/*/*/**",
      "node_modules/minecraft-assets/minecraft-assets/data/*/*.json",
      "node_modules/minecraft-assets/minecraft-assets/data/1.21.4/blocks/**",
      "node_modules/minecraft-assets/minecraft-assets/data/1.21.4/entity/**",
      "node_modules/minecraft-assets/minecraft-assets/data/1.21.4/items/**"
    ],
    "fileAssociations": [
      {
        "ext": "mcai",
        "name": "ArchItect 工程",
        "role": "Editor",
        "mimeType": "application/x-architect-mcai"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "../../packages/render/data",
        "to": "data"
      }
    ],
    "icon": "build/icon.png"
  }
}

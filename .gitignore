# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# npm/pnpm 的 registry 凭据就存在这里（//registry/:_authToken=...），别让它进库
.npmrc

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# ---------------------------------------------------------------------------
# ArchItect — 密钥与本地状态（见 plan.md §13.3）
# 红线 1：密钥不进版本库（.env 系列见上方 dotenv 段落）
# 红线 2：密钥不进 .mcai（.mcai 是要分享给别人的工程文件）
# ---------------------------------------------------------------------------
*.key
*.pem
secrets.json
secrets.bin
credentials.json

# 会话期解压工作目录（含 WAL 与中间态，不是最终产物）
*.mcai.d/
.architect/

# Electron userData（safeStorage 密文落在这里，永远不该进仓库）
**/userData/

# 本地导出产物（示例/测试用的 fixture 例外，见下）
/exports/
*.schem
*.litematic
*.mcstructure
!fixtures/**/*.schem
!fixtures/**/*.litematic
!fixtures/**/*.mcstructure

# electron-builder 打包产物。体积在 800MB 量级（大部分是资源包与方块数据），
# 任何时候都不该进版本库——要验打包就本地跑一次：
#   pnpm --filter @architect/desktop package:dir
release/
